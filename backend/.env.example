# ---------------------------------------------------------------------------
# Copy to backend/.env. Values below are a working LOCAL DEV setup — never put
# real credentials in this committed file. Production: DJANGO_ENV=production,
# DEBUG=False, DEV_AUTH_BYPASS unset, "PROD: keep False" flags False.
# ---------------------------------------------------------------------------

# --- Environment -----------------------------------------------------------
DJANGO_ENV=development           # development | staging | production
DEBUG=True                       # refused with DJANGO_ENV=production

# create_dev_user JWTs + native email/password form when no Firebase env is set.
DEV_AUTH_BYPASS=True

# --- Core secrets ---------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-me

# --- LLM providers -------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here      # Google AI Studio API key
GROQ_API_KEY=                                # optional fallback / cheaper eval runs
SQL_GENERATION_MODEL=gemini-2.0-flash
VERIFICATION_MODEL=gemini-2.0-flash

# Privacy-first defaults are OFF in code. These dev values send synthetic sample
# data to the LLM — acceptable only for the local synthetic sample DB.
# PROD / STAGING: keep both False.
LLM_ALLOW_SAMPLE_VALUES_IN_PROMPT=True
LLM_ALLOW_PROVIDER_FALLBACK=False

# --- Sample database (demo + eval suite) -------------------------------
# LOCAL ONLY. Use a dedicated local Postgres db or a throwaway Supabase project
# with credentials used nowhere else. Tables live in SAMPLE_DB_SCHEMA, not
# `public`. Supabase: use the Session pooler / direct connection (5432), not 6543.
SAMPLE_DB_URL=postgresql://postgres:postgres@localhost:5432/postgres
SAMPLE_DB_SCHEMA=t2s_sample
SAMPLE_DB_READONLY_ROLE=text2sql_ro

# --- Guardrails / audit -------------------------------------------------
# Conservative defaults, kept the same for local and prod:
#   AUDIT_LOG_STORE_SQL  — off => QueryExecutionLog keeps only a SHA-256
#                          fingerprint, never the SQL text or NL question.
#   EXPOSE_EXPLAIN_PLAN   — off => the raw EXPLAIN plan is not returned to clients.
# Flip either to True locally only if you need it for debugging.
AUDIT_LOG_STORE_SQL=False
EXPOSE_EXPLAIN_PLAN=False
BACK_TRANSLATION_FLAG_THRESHOLD=0.55
# Multi-query agreement check in /api/llm/query/ — one extra generation +
# execution per request. Off by default; requests can opt in with deep=true.
VERIFICATION_MULTI_QUERY=False

# --- CORS --------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Firebase (OPTIONAL for local dev) --------------------------------
# Only for Firebase / Google sign-in. With DEV_AUTH_BYPASS the app runs on native
# email/password and you can skip this entirely. Download a service account key:
# Firebase console > Project settings > Service accounts > Generate new private
# key. Never commit the key file.
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/path/to/firebase-service-account.json

# --- Email (OPTIONAL: OTP password reset) ---------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Django app database (OPTIONAL — SQLite by default) ---------------
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

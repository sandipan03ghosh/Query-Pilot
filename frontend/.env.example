# Copy to frontend/.env

# API base URL for the Django backend.
VITE_API_URL=http://localhost:8000

# --- Firebase (OPTIONAL) --------------------------------------------------
# Leave these UNSET for local development: the login screen then shows a native
# email/password form that authenticates against the Django backend (pair with
# DEV_AUTH_BYPASS=True and `python manage.py create_dev_user` on the backend).
#
# Set all of API_KEY / AUTH_DOMAIN / APP_ID to enable Firebase + Google sign-in.
# Values: Firebase console > Project settings > General > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
